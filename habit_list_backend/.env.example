# =======================================================
# 陪伴式自我记录 App · 后端环境变量示例
# 复制本文件为 .env，并填入真实值。真实 .env 已加入 .gitignore。
# =======================================================

# ---- 服务基础 ----
APP_ENV=dev                                    # dev / prod
APP_HOST=0.0.0.0
APP_PORT=8780
API_PREFIX=/api/v1
LOG_LEVEL=INFO
PROCESS_ROLE=all                               # 本地=all；生产拆为 api / worker
CORS_ALLOWED_ORIGINS=*                         # 生产必须写明确的后台 Web Origin，多个用逗号分隔

# ---- 鉴权（旧静态原型仅在 dev 使用；正式联调切换 sessions）----
AUTH_MODE=legacy                               # legacy / sessions；生产只能 sessions
API_AUTH_TOKEN=replace_with_a_long_random_string_比如openssl_rand_hex_32
ADMIN_TOKEN=replace_with_another_long_random_string
AUTH_TOKEN_PEPPER=                             # sessions 模式必填，至少 32 随机字符
PII_ENCRYPTION_KEY=                            # Fernet.generate_key()，用于身份邮箱等 PII
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_MAX_SESSIONS_PER_USER=10
APPLE_CLIENT_IDS=                              # iOS Bundle ID；多个 audience 用逗号分隔
APPLE_JWKS_CACHE_SECONDS=3600

# ---- 独立管理员身份 ----
ADMIN_MFA_ENCRYPTION_KEY=                      # 与 PII_ENCRYPTION_KEY 不同的 Fernet key
ADMIN_ACCESS_TTL_SECONDS=900
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_TOTP_ISSUER=Inner Terrain Admin

# ---- 数据库（SQLite 本地，绝对路径 / 相对路径均可，生产建议放 /var/lib/habit_list 持久化）----
DATABASE_URL=sqlite+aiosqlite:///./data/habit_list.db
DATABASE_SCHEMA_MODE=auto_create               # 本地 auto_create；生产必须 alembic
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
SQLITE_VSS_EXT_PATH=                            # 留空=尝试自动加载；Docker 镜像里会放在 /app/vss0.so / /app/vector0.so
FTS5_TOKENIZER=unicode61                        # unicode61（2gram中文保底）；装了 jieba 就改成 jieba

# ---- 阿里云 DashScope / 百炼（LLM/Embedding/ASR/TTS/审核）----
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-real-key-here
DASHSCOPE_LLM_MODEL=qwen-plus
# 最新 qwen3.7 文本向量（1024 维）；兼容模式下 dimensions 参数不需要传
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
# 必须与 EMBEDDING_MODEL 的默认输出维度一致：qwen3.7-text-embedding=1024 / text-embedding-v3=1536
DASHSCOPE_EMBEDDING_DIM=1024
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_TTS_MODEL=cosyvoice-v1
DASHSCOPE_MODERATION_MODEL=qwen-moderation-plus
DASHSCOPE_TIMEOUT_SEC=120
DASHSCOPE_MAX_RETRY=2
# 限制每分钟请求数（避免阿里云超支）
RPM_LIMIT_PER_MIN=60

# ---- 记忆 OS 参数 ----
SYSTEM1_N_RETRIEVAL_TOPK=5                      # 三重检索+RRF后最终保留TopN注入Prompt
SYSTEM1_CONTEXT_WINDOW_ROUNDS=16                # Working最近多少轮注入（约近30分钟会话）
SYSTEM2_SLEEP_CONSOLIDATION_CRON="0 3 * * 0"    # 每周日 03:00 本地时区做睡眠巩固
SYSTEM2_EBBINGHAUS_CRON="30 4 * * *"            # 每天 04:30 重算艾宾浩斯权重
SYSTEM2_AUTO_CONFIRM_CONF=0.85                  # 睡眠巩固自动入Semantic阈值；以下进Insight待确认
SYSTEM2_INSIGHT_CONF_MIN=0.6
FORGET_STRENGTH=0.86                            # 艾宾浩斯衰减（1.0=正常，越小忘越快）

# ---- Memory V2（证据化、可版本、可追踪）----
# off / shadow_write / shadow_retrieve / active；首次上线保持 shadow_write
MEMORY_V2_MODE=shadow_write
# rules=零模型成本；hybrid=LLM 结构化提取失败时退回规则；llm=失败进入重试队列
MEMORY_V2_EXTRACTOR_MODE=rules
MEMORY_V2_POLICY_VERSION=terrain-memory-v1
MEMORY_V2_EXTRACTOR_VERSION=terrain-extractor-v1
MEMORY_V2_RETRIEVAL_TOPK=2
MEMORY_V2_CANDIDATE_LIMIT=200
MEMORY_V2_MIN_RETRIEVAL_SCORE=0.30
MEMORY_V2_AUTO_CONFIRM_CONF=0.86
MEMORY_V2_WORKER_INTERVAL_SECONDS=15
MEMORY_V2_OUTBOX_BATCH_SIZE=20
MEMORY_V2_OUTBOX_MAX_ATTEMPTS=5
# Windows 本地默认关闭；生产 PostgreSQL + pgvector 建好后再开启
MEMORY_V2_EMBEDDING_ENABLED=false

# ---- 独立 Worker ----
WORKER_HEARTBEAT_PATH=./data/worker-heartbeat.json
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45

# ---- 默认用户 ----
# MVP 只有一个你。生成 UUID7 一次写死（或让后端 first-run 自动生成）
DEFAULT_USER_ID=01920000-0000-0000-0000-000000000001
DEFAULT_USER_LOCALE=zh-CN
DEFAULT_USER_TIMEZONE=Asia/Shanghai

# ---- 部署/证书（Nginx/HTTPS）----
DEPLOY_DOMAIN=your.domain.example.com            # 你要挂的域名，先解析A记录到81.70.177.186
DEPLOY_EMAIL=you@example.com                      # certbot 注册邮箱
