# Local Docker/PostgreSQL integration profile only. Never deploy this file.
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18780
PROCESS_ROLE=api

DATABASE_SCHEMA_MODE=alembic
DATABASE_URL=postgresql+psycopg://terrain:terrain_integration_password@postgres:5432/terrain
POSTGRES_DB=terrain
POSTGRES_USER=terrain
POSTGRES_PASSWORD=terrain_integration_password

AUTH_MODE=sessions
AUTH_TOKEN_PEPPER=integration-token-pepper-000000000000000000000001
PII_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
APPLE_CLIENT_IDS=com.example.innerterrain.integration
ADMIN_MFA_ENCRYPTION_KEY=MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE=

DASHSCOPE_API_KEY=sk-integration-only-not-a-real-key
MEMORY_V2_MODE=shadow_write
MEMORY_V2_EXTRACTOR_MODE=rules
MEMORY_V2_EMBEDDING_ENABLED=false

DEPLOY_DOMAIN=integration.invalid
DEPLOY_EMAIL=integration@example.invalid
APP_HOST_PORT=18780
