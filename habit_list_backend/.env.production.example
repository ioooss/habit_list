# 生产拓扑示例。复制为 .env.production 后只保存在服务器，不要提交。
APP_ENV=prod
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=https://admin.your.domain.example.com

# Compose 的 app/worker 会分别覆盖 PROCESS_ROLE。
PROCESS_ROLE=api
DATABASE_SCHEMA_MODE=alembic
DATABASE_URL=postgresql+psycopg://terrain:replace_with_url_encoded_password@postgres:5432/terrain
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

POSTGRES_DB=terrain
POSTGRES_USER=terrain
POSTGRES_PASSWORD=replace_with_a_long_database_password

# 用户会话：服务端只保存 HMAC 后的随机 token；Refresh Token 每次使用都会轮换。
AUTH_MODE=sessions
AUTH_TOKEN_PEPPER=replace_with_at_least_32_random_characters
PII_ENCRYPTION_KEY=replace_with_fernet_key
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_MAX_SESSIONS_PER_USER=10
APPLE_CLIENT_IDS=com.yourcompany.innerterrain
APPLE_JWKS_CACHE_SECONDS=3600

# 管理员与普通用户身份完全分离，登录强制密码 + TOTP。
ADMIN_MFA_ENCRYPTION_KEY=replace_with_a_different_fernet_key
ADMIN_ACCESS_TTL_SECONDS=900
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_TOTP_ISSUER=Inner Terrain Admin
DEFAULT_USER_ID=01920000-0000-0000-0000-000000000001
DEFAULT_USER_LOCALE=zh-CN
DEFAULT_USER_TIMEZONE=Asia/Shanghai

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-replace_with_server_side_key
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIM=1024
DASHSCOPE_TIMEOUT_SEC=120
DASHSCOPE_MAX_RETRY=2
RPM_LIMIT_PER_MIN=60

MEMORY_V2_MODE=shadow_write
MEMORY_V2_EXTRACTOR_MODE=rules
MEMORY_V2_POLICY_VERSION=terrain-memory-v1
MEMORY_V2_EXTRACTOR_VERSION=terrain-extractor-v1
MEMORY_V2_RETRIEVAL_TOPK=2
MEMORY_V2_CANDIDATE_LIMIT=200
MEMORY_V2_MIN_RETRIEVAL_SCORE=0.30
MEMORY_V2_AUTO_CONFIRM_CONF=0.86
MEMORY_V2_WORKER_INTERVAL_SECONDS=15
MEMORY_V2_OUTBOX_BATCH_SIZE=20
MEMORY_V2_OUTBOX_MAX_ATTEMPTS=5
MEMORY_V2_EMBEDDING_ENABLED=false

WORKER_HEARTBEAT_PATH=/tmp/habit-list-worker-heartbeat.json
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45

DEPLOY_DOMAIN=your.domain.example.com
DEPLOY_EMAIL=you@example.com
APP_HOST_PORT=8780
